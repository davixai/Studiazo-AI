# Copiază acest fișier în .env.local și completează valorile reale.
# .env.local este exclus din Git. Nu pune niciodată chei reale în acest fișier.

# --- Supabase (Project Settings → API Keys) ---
# URL-ul proiectului și cheia publishable sunt publice prin design (protejate de RLS).
NEXT_PUBLIC_SUPABASE_URL=https://exemplu-proiect.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLU_NU_ESTE_REAL

# URL-ul public al aplicației (folosit în emailurile de confirmare și resetare)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OpenAI (doar pe server; fără prefix NEXT_PUBLIC_) ---
# Cheia se creează în platform.openai.com → API keys. Facturarea API e separată de ChatGPT Pro.
OPENAI_API_KEY=sk-EXEMPLU_NU_ESTE_REAL
OPENAI_MODEL=gpt-6-luna
# Gratuit, fără card: Groq (https://console.groq.com/keys). Cheia gsk_… merge în OPENAI_API_KEY.
# AI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b
# Fără cont și fără cheie (lent: un răspuns la ~30 s): Pollinations, prin Chat Completions.
# AI_BASE_URL=https://text.pollinations.ai/openai
# AI_API=chat
# AI_KEYLESS=1
# OPENAI_MODEL=openai

# Limite (opționale; valorile implicite sunt în src/lib/ai/config.ts)
# --- Citirea orarului din poză (opțional, separat de AI-ul principal) ---
# Pollinations fără cheie nu primește poze: orarul se citește atunci cu OCR (tesseract.js, pe server) și AI-ul de text,
# mai lent și mai puțin precis. Pentru o citire mai bună, un AI care vede imagini, gratuit și fără card:
# Groq → https://console.groq.com/keys (cont cu email), apoi:
# AI_VISION_BASE_URL=https://api.groq.com/openai/v1
# AI_VISION_API_KEY=gsk_...
# AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Fără aceste trei, orarul se citește doar dacă AI-ul principal e OpenAI/Groq în modul Responses.

AI_REQUESTS_PER_HOUR=30
AI_MAX_OUTPUT_TOKENS=1200

# --- Google Classroom (opțional; doar pe server) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Redirect URI autorizat: {NEXT_PUBLIC_APP_URL}/api/classroom/callback. Pașii: docs/SETUP.md, „Google Classroom”.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Doar pentru dezvoltare ---
# 1 = pornește interfața cu date demonstrative când Supabase nu este configurat.
STUDIA_PREVIEW=0
